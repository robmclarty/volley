{
  "$schema": "./node_modules/checkride/schema/checkride.config.schema.json",
  "checks": {
    "types": "tsc",
    "lint": "oxlint",
    "struct": "ast-grep",
    "dead": "fallow",
    "dupes": "fallow",
    "test": {
      "use": "vitest",
      "args": ["exec", "vitest", "run", "--reporter=default", "--reporter=json", "--outputFile=.check/test.json"]
    },
    "docs": false,
    "links": "links",
    "spell": false,
    "intent": {
      "command": "pnpm",
      "args": ["exec", "keyframes", "check", "--json", "--strict"],
      "outputFile": "intent.json",
      "description": "keyframes.md against the repo",
      "note": "A gate for developing volley, not part of a volley run: it fails when a held-by test, a rule or a Map path moves out from under keyframes.md."
    }
  },
  "timeout": 600
}
