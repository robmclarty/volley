# volley environment variables (spec §12). All optional.

# Forwarded to the claude CLI subprocess when auth_mode is api_key/auto.
# Triggers the billing-meter warning: with a key set, runs bill the API key,
# not your subscription.
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Path to the claude binary. Default: `claude` on PATH.
# VOLLEY_CLAUDE_BIN=/opt/claude/bin/claude

# auto | oauth | api_key. Default: auto (use whatever the CLI is configured with).
# VOLLEY_AUTH_MODE=auto

# Harness logging verbosity: error, warn, info, debug. Default: info.
# VOLLEY_LOG_LEVEL=info

# Disable colored output (standard NO_COLOR is also respected).
# VOLLEY_NO_COLOR=1

# JSON file of fascicle Pricing rows keyed "<provider>:<model_id>", merged into
# the engine's pricing table. Rarely needed for claude_cli (CLI-reported cost).
# VOLLEY_PRICING_PATH=./custom-pricing.json
