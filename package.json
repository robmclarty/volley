{
  "name": "@robmclarty/volley",
  "version": "0.5.0",
  "description": "A CLI harness that runs a builder/critic loop until a task passes both a deterministic check pipeline and a natural-language acceptance review.",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Rob McLarty",
    "email": "hello@robmclarty.com",
    "url": "https://robmclarty.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robmclarty/volley.git"
  },
  "homepage": "https://github.com/robmclarty/volley#readme",
  "bugs": {
    "url": "https://github.com/robmclarty/volley/issues"
  },
  "keywords": [
    "agents",
    "agentic",
    "harness",
    "builder-critic",
    "code-review",
    "claude-code",
    "ollama",
    "lmstudio",
    "local-llm",
    "evaluation",
    "cli",
    "typescript",
    "fascicle",
    "checkride"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.2",
  "bin": {
    "volley": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/builder/presets",
    "src/critic/presets"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "checkride"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "ai": "7.0.22",
    "cac": "6.7.14",
    "fascicle": "0.9.5",
    "ipaddr.js": "2.4.0",
    "linkedom": "0.18.13",
    "picocolors": "1.1.1",
    "turndown": "7.2.4",
    "undici": "8.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.42.1",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "24.13.2",
    "@types/turndown": "5.0.6",
    "ai-sdk-ollama": "4.0.0",
    "checkride": "0.4.1",
    "fallow": "2.48.0",
    "oxlint": "1.72.0",
    "oxlint-tsgolint": "0.22.1",
    "tsup": "8.5.1",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
