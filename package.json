{
  "name": "volley",
  "version": "0.2.1",
  "description": "A CLI harness that runs a builder/critic loop until a task passes both a deterministic check pipeline and a natural-language acceptance review.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.2",
  "bin": {
    "volley": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/critic/presets"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "checkride"
  },
  "dependencies": {
    "ai": "^6.0.0",
    "cac": "^6.7.14",
    "fascicle": "^0.8.16",
    "picocolors": "^1.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.0",
    "@types/node": "^24.0.0",
    "checkride": "^0.2.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.21.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
