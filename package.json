{
  "name": "@robmclarty/volley",
  "version": "0.10.0",
  "description": "A CLI harness that runs a builder/critic loop until a task passes both a deterministic check pipeline and a natural-language acceptance review.",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Rob McLarty",
    "email": "hello@robmclarty.com",
    "url": "https://robmclarty.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robmclarty/volley.git"
  },
  "homepage": "https://github.com/robmclarty/volley#readme",
  "bugs": {
    "url": "https://github.com/robmclarty/volley/issues"
  },
  "keywords": [
    "agents",
    "agentic",
    "harness",
    "builder-critic",
    "code-review",
    "claude-code",
    "ollama",
    "lmstudio",
    "local-llm",
    "evaluation",
    "cli",
    "typescript",
    "fascicle",
    "checkride"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.2",
  "bin": {
    "volley": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/builder/presets",
    "src/critic/presets",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "checkride",
    "diagram": "fascicle-diagram src/diagram.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@mozilla/readability": "0.6.0",
    "ai": "7.0.140",
    "cac": "7.1.0",
    "fascicle": "0.17.1",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.13",
    "picocolors": "1.1.1",
    "turndown": "7.2.4",
    "undici": "8.12.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "ai-sdk-ollama": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "ai-sdk-ollama": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ast-grep/cli": "0.50.0",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.19.2",
    "@types/turndown": "5.0.6",
    "ai-sdk-ollama": "4.3.0",
    "checkride": "0.14.0",
    "fallow": "3.33.1",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
