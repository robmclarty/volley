{
  "name": "@robmclarty/volley",
  "version": "0.5.2",
  "description": "A CLI harness that runs a builder/critic loop until a task passes both a deterministic check pipeline and a natural-language acceptance review.",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Rob McLarty",
    "email": "hello@robmclarty.com",
    "url": "https://robmclarty.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robmclarty/volley.git"
  },
  "homepage": "https://github.com/robmclarty/volley#readme",
  "bugs": {
    "url": "https://github.com/robmclarty/volley/issues"
  },
  "keywords": [
    "agents",
    "agentic",
    "harness",
    "builder-critic",
    "code-review",
    "claude-code",
    "ollama",
    "lmstudio",
    "local-llm",
    "evaluation",
    "cli",
    "typescript",
    "fascicle",
    "checkride"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.2",
  "bin": {
    "volley": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/builder/presets",
    "src/critic/presets",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "checkride"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "ai": "7.0.111",
    "cac": "7.0.0",
    "fascicle": "0.12.9",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.13",
    "picocolors": "1.1.1",
    "turndown": "7.2.4",
    "undici": "8.11.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.6",
    "@types/turndown": "5.0.6",
    "ai-sdk-ollama": "4.3.0",
    "checkride": "0.13.0",
    "fallow": "3.28.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
